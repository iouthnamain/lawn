# Backend variables. Save actual values in ignored .env.convex.local.
# Apply with bun x convex env set --force --from-file .env.convex.local
# CONVEX_SITE_URL is managed by the self-hosted backend's CONVEX_SITE_ORIGIN.
SITE_URL=https://your-host.your-tailnet.ts.net:8443
JWT_PRIVATE_KEY=
JWKS=
RAILWAY_ENDPOINT=https://your-host.your-tailnet.ts.net:8446
RAILWAY_PUBLIC_URL=https://your-host.your-tailnet.ts.net:8446
RAILWAY_ACCESS_KEY_ID=
RAILWAY_SECRET_ACCESS_KEY=
RAILWAY_REGION=us-east-1
RAILWAY_BUCKET_NAME=videos
LAWN_MEDIA_URL=http://127.0.0.1:5297
LAWN_PUBLIC_URL=https://your-host.your-tailnet.ts.net:8443
LAWN_MEDIA_SECRET=
LAWN_STORAGE_LIMIT_GIB=400
